name = "follow-your-eye-collector"
main = "worker.mjs"
compatibility_date = "2026-10-06"
preview_urls = false

[vars]
ALLOWED_ORIGIN = "https://vincentliu.ai"

[[d1_databases]]
binding = "DB"
database_name = "REPLACE_WITH_EXISTING_D1_DATABASE_NAME"
database_id = "REPLACE_WITH_D1_DATABASE_ID"

[observability]
enabled = true

[observability.logs]
enabled = true
